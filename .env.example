# FailureForensicsTool Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your local setup

# Ollama models directory (optional - defaults to system default if omitted)
# OLLAMA_MODELS=/path/to/ollama/models

# Ollama service endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Default LLM model for extraction, summarization, and judge evaluation
# Recommended lightweight model: qwen2.5:1.5b (fast, low VRAM) or qwen2.5:7b-instruct
OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b

# Hardware acceleration options
USE_NVIDIA_GPU=true
NUM_GPU_LAYERS=99
CONTEXT_SIZE=2048
